body {
  background-color: #f5f5dc;
  font-family: Arial, sans-serif;
  text-align: center;
}

.container {
  margin-top: 40px;
}

.box,
.form-container {
  background-color: white;
  width: 350px;
  margin: auto;
  padding: 25px;
  border-radius: 10px;
  box-shadow: 0px 0px 15px rgba(0,0,0,0.2);
}

.title {
  font-size: 24px;
  color: #333;
}

input,
select,
button {
  width: 90%;
  padding: 10px;
  margin: 10px 0;
}

button {
  background-color: #333;
  color: white;
  border: none;
  cursor: pointer;
}

button:hover {
  background-color: #555;
}

.hidden {
  display: none;
}

.success-message {
  background-color: #e0f7fa;
  padding: 20px;
  border-radius: 10px;
}

@media screen and (max-width: 600px) {
  .box,
  .form-container {
    width: 95%;
  }
}
